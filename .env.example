# Copia a .env en la raíz del proyecto. Backend (Django) lee estas variables.

# Seguridad (producción)
SECRET_KEY=tu-clave-secreta-muy-larga-y-aleatoria
DEBUG=False

# MySQL (opción recomendada)
MYSQL_DATABASE=pantalla_db
MYSQL_USER=pantalla_user
MYSQL_PASSWORD=tu_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Opcional: también puedes usar URL MySQL en una sola variable
# DATABASE_URL=mysql://user:pass@host:3306/dbname

# Admin por defecto (solo si no existe ningún usuario)
DJANGO_ADMIN_USER=admin1
DJANGO_ADMIN_PASSWORD=123456
DJANGO_ADMIN_EMAIL=admin@example.com

# Hosts (opcional)
# ALLOWED_HOSTS=localhost,127.0.0.1,tudominio.com
# CSRF_TRUSTED_ORIGINS=https://tudominio.com

# Correo para recuperacion de contrasena (Mailtrap API)
MAILTRAP_API_TOKEN=pon_aqui_tu_nuevo_token_mailtrap
MAILTRAP_API_HOST=https://send.api.mailtrap.io
DEFAULT_FROM_EMAIL=no-reply@tudominio.com
